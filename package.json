{
  "name": "embodiscope",
  "version": "0.1.0",
  "description": "Browser-based inspection & analysis platform for embodied AI / robot learning datasets (LeRobot v2.x / v3.0).",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "release": "npm run build:single && node -e \"require('fs').copyFileSync('dist-single/index.html','embodiscope.html')\"",
    "serve": "node scripts/serve.mjs",
    "mock-llm": "node scripts/mock-llm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hyparquet": "^1.17.0",
    "hyparquet-compressors": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
